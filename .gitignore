*.pyc
__pycache__/
venv/
*.egg-info/

# Everything in data/ is a runtime artifact, not source: crawl/review logs,
# and muni.db + .flask_secret_key, which are live security secrets once 2FA
# setup completes (muni.db holds the registered TOTP secret in auth_totp;
# .flask_secret_key signs session cookies) — committing either would let
# anyone who reads the repo forge an authenticated session or bypass 2FA.
data/